+#[test]
+fn host_navigation_keeps_inbox_open_inside_wordcraft() {
+    let (mut app, _) = host_app(false);
+    let events = std::rc::Rc::new(std::cell::RefCell::new(Vec::new()));
+    let seen = events.clone();
+    app.services.host_navigation = Some(Box::new(move |command| seen.borrow_mut().push(command.to_string())));
+    let before = app.session.document_id();
+    app.run("file.new", json!({})).unwrap();
+    app.run("file.open", json!({})).unwrap();
+    assert_eq!(events.borrow().clone(), vec!["file.new".to_string(), "file.open".to_string()]);
+    assert_eq!(app.session.document_id(), before);
+    let bytes = wordcraft_engine::io::save_bytes("host.docx", &typed().session.doc).unwrap();
+    app.run("file.open", json!({"path": "host.docx", "data": wordcraft_engine::cmd::insert::base64_encode(&bytes)})).unwrap();
+    assert_eq!(app.session.path.as_ref().unwrap().to_string_lossy(), "host.docx");
+    assert_eq!(events.borrow().len(), 2);
+}
