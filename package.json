{
  "name": "safe-pdf-rename",
  "version": "2.0.4",
  "description": "Safe Windows PDF renaming utility",
  "author": "Local",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri dev",
    "web:dev": "vite",
    "web:build": "tsc -b && vite build",
    "build": "npm run web:build",
    "tauri:build": "tauri build",
    "native:smoke": "node scripts/native-smoke.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@docx-editor.dev/core": "^2.33.0",
    "@docx-editor.dev/editor-api": "2.33.0",
    "@docx-editor.dev/i18n": "^2.33.0",
    "@docx-editor.dev/react": "^2.33.0",
    "@floating-ui/react": "^0.27.20",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "exceljs": "^4.4.0",
    "page-mascot": "^0.1.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "latest",
    "vite": "^6.4.5"
  }
