+/// Pages for one manual-duplex pass, preserving the selected copy collation.
+pub fn manual_duplex_pages(plan: &PrintPlan, collate: bool, pass: &str, reverse: bool) -> Result<Vec<usize>, String> {
+    if !matches!(pass, "front" | "back") {
+        return Err("manual duplex pass must be front or back".into());
+    }
+    let copies = plan.copies as usize;
+    let mut pages = Vec::new();
+    for copy in 0..copies {
+        for slot in 0..plan.chosen {
+            let index = if collate { copy * plan.chosen + slot } else { slot * copies + copy };
+            if (slot % 2 == 0) == (pass == "front") {
+                if let Some(page) = plan.pages.get(index) {
+                    pages.push(*page);
+                }
+            }
+        }
+    }
+    if reverse {
+        pages.reverse();
+    }
+    Ok(pages)
+}
