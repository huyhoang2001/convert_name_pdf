+#[test]
+fn embedded_documents_open_at_100_percent_zoom() {
+    use wordcraft_doc::{Zoom, ZoomFit};
+
+    for saved in [Zoom { percent: 80, fit: None }, Zoom { percent: 125, fit: None }, Zoom { percent: 75, fit: Some(ZoomFit::PageWidth) }] {
+        let mut doc = wordcraft_doc::Document::new();
+        doc.settings.zoom = Some(saved);
+        let bytes = wordcraft_engine::io::save_bytes("zoom.docx", &doc).unwrap();
+        for embedded in [false, true] {
+            let mut a = app();
+            let inbox: Inbox = Inbox::default();
+            a.services.inbox = Some(inbox.clone());
+            if embedded {
+                a.services.host_save = Some(Box::new(|_, _, _| Ok(())));
+            }
+            inbox.lock().unwrap().push(("zoom.docx".into(), bytes.clone()));
+            a.drain_inbox();
+            assert_eq!(a.session.view.zoom, if embedded { 1.0 } else { saved.percent as f32 / 100.0 });
+            assert_eq!(
+                a.session.view.fit,
+                if embedded {
+                    ""
+                } else if saved.fit.is_some() {
+                    "pageWidth"
+                } else {
+                    ""
+                }
+            );
+            assert!(!a.session.dirty);
+        }
+    }
+}
