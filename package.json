{
  "name": "safe-pdf-rename",
  "version": "1.1.4",
  "description": "Safe Windows PDF renaming utility",
  "author": "Local",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5175 && electron .\"",
    "build": "tsc -b && vite build && electron-builder --win portable",
    "test": "node --test"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.22",
    "exceljs": "^4.4.0",
    "page-mascot": "^0.1.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "^6.4.5",
    "wait-on": "latest"
  }
}
