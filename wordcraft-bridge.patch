+  <script>
+    (() => {
+      if (new URLSearchParams(location.search).get('host') !== 'parent') return;
+      try { if (parent === window || parent.location.origin !== location.origin) return; } catch { return; }
+      let wasmLoaded = false;
+      window.addEventListener('TrunkApplicationStarted', () => { wasmLoaded = true; });
+      const report = (stage, error) => {
+        if (!wasmLoaded) parent.postMessage({ type: 'wordcraft:failed', stage, error: String(error).slice(0, 240) }, location.origin);
+      };
+      window.addEventListener('error', event => {
+        const asset = event.target?.src || event.target?.href;
+        if (asset && !/wordcraft-web-|\/snippets\//.test(asset)) return;
+        report(asset ? 'asset-loading' : 'wasm-script', asset ? `Could not load ${new URL(asset).pathname.split('/').pop()}` : event.message || 'Wordcraft script failed.');
+      }, true);
+      window.addEventListener('unhandledrejection', event => report('wasm-initialization', event.reason || 'Wordcraft WASM initialization failed.'));
+    })();
+  </script>
