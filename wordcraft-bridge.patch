+#[cfg(test)]
+mod host_tests {
+    use super::*;
+
+    fn discovery() -> Value {
+        json!({
+            "language": "VI",
+            "printers": [{
+                "name": "Office Printer",
+                "label": "Office Printer",
+                "default": true,
+                "longEdge": true,
+                "shortEdge": false
+            }],
+            "preferences": {
+                "Office Printer": {"face": "faceUp", "leadingEdge": "bottom"}
+            }
+        })
+    }
+
+    #[test]
+    fn host_discovery_keeps_exact_capabilities_and_saved_refeed_preference() {
+        let mut settings = PrintSettings::default();
+        settings.host_discovered(&discovery());
+        assert_eq!(settings.host_printer, "Office Printer");
+        assert_eq!(settings.host_language, "VI");
+        assert_eq!(settings.host_printers[0].long_edge, Some(true));
+        assert_eq!(settings.host_printers[0].short_edge, Some(false));
+        assert_eq!((settings.host_face.as_str(), settings.host_leading_edge.as_str()), ("faceUp", "bottom"));
+    }
+
+    #[test]
+    fn host_params_leave_automatic_copies_to_spooler_and_split_manual_passes() {
+        let mut settings = PrintSettings { copies: 3, collate: false, host_printer: "Office Printer".into(), ..Default::default() };
+        let automatic = settings.host_params(None);
+        assert_eq!(automatic["copies"], 1);
+        assert_eq!(automatic["hostCopies"], 3);
+        settings.host_duplex = "manual".into();
+        settings.host_face = "faceDown".into();
+        let back = settings.host_params(Some("back"));
+        assert_eq!(back["copies"], 3);
+        assert_eq!(back["manualPass"], "back");
+        assert_eq!(back["reverseManualPass"], true);
+        settings.host_result(&json!({"pass": "front", "receipt": "queued"}));
+        assert_eq!(settings.host_stage, HostStage::AwaitingReload);
+    }
+}
